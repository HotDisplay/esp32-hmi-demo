# esp_lvgl_port 2.9.0 selects a DPI callback absent in ESP-IDF v6.0.
# Compile a corrected build-directory copy; keep managed_components untouched.
# Upstream: https://github.com/espressif/esp-bsp/blob/f0ef9497efce684997ce391edd19733483e250a5/components/esp_lvgl_port/src/lvgl9/esp_lvgl_port_disp.c
function(apply_esp_lvgl_port_compat)
    include($ENV{IDF_PATH}/tools/cmake/version.cmake)
    set(idf_version "${IDF_VERSION_MAJOR}.${IDF_VERSION_MINOR}.${IDF_VERSION_PATCH}")
    idf_build_get_property(target IDF_TARGET)
    if(CONFIG_GUI_CSI_CAMERA_RGB_DIRECT_DMA AND
       (NOT target STREQUAL "esp32p4" OR NOT idf_version VERSION_EQUAL "6.0.0"))
        message(FATAL_ERROR "GUI_CSI_CAMERA_RGB_DIRECT_DMA requires ESP32-P4 with IDF 6.0.0; review RGB frame-buffer synchronization for target ${target}, IDF ${idf_version}.")
    endif()
    if(NOT target STREQUAL "esp32p4" OR NOT idf_version VERSION_EQUAL "6.0.0")
        return()
    endif()

    idf_component_get_property(port_version espressif__esp_lvgl_port COMPONENT_VERSION)
    if(NOT port_version VERSION_EQUAL "2.9.0")
        if(CONFIG_GUI_CSI_CAMERA_RGB_DIRECT_DMA)
            message(FATAL_ERROR "GUI_CSI_CAMERA_RGB_DIRECT_DMA requires esp_lvgl_port 2.9.0; review RGB frame-buffer synchronization for version ${port_version}.")
        endif()
        message(FATAL_ERROR "Review esp_lvgl_port compatibility for version ${port_version} before building with IDF ${idf_version}.")
    endif()
    idf_component_get_property(port_dir espressif__esp_lvgl_port COMPONENT_DIR)
    set(relative_source "src/lvgl9/esp_lvgl_port_disp.c")
    set(original_source "${port_dir}/${relative_source}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original_source}")
    file(READ "${original_source}" source_code)

    # Match only the DPI assignment. RGB's on_frame_buf_complete stays intact.
    set(old_assignment "cbs.on_frame_buf_complete = lvgl_port_flush_dpi_vsync_ready_callback;")
    set(new_assignment "cbs.on_refresh_done = lvgl_port_flush_dpi_vsync_ready_callback;")
    string(REGEX MATCHALL "cbs\\.on_frame_buf_complete = lvgl_port_flush_dpi_vsync_ready_callback" matches "${source_code}")
    list(LENGTH matches match_count)
    string(FIND "${source_code}" "${old_assignment}" assignment_offset)
    if(NOT match_count EQUAL 1 OR assignment_offset LESS 0)
        message(FATAL_ERROR "esp_lvgl_port DPI source changed; review the compatibility correction.")
    endif()
    string(REPLACE "${old_assignment}" "${new_assignment}" source_code "${source_code}")

    if(CONFIG_GUI_CSI_CAMERA_RGB_DIRECT_DMA)
        string(REGEX MATCHALL "xSemaphoreTake\\(disp_ctx->trans_sem, 0\\)" waits "${source_code}")
        list(LENGTH waits wait_count)
        string(REGEX MATCH "xSemaphoreTake\\(disp_ctx->trans_sem, 0\\);[ \t\r\n]+xSemaphoreTake\\(disp_ctx->trans_sem, portMAX_DELAY\\);" old_wait "${source_code}")
        if(NOT wait_count EQUAL 1 OR old_wait STREQUAL "")
            message(FATAL_ERROR "esp_lvgl_port RGB flush wait changed; review the direct-DMA frame-buffer synchronization correction.")
        endif()
        # IDF 6.0 may prefetch the old RGB frame-buffer link for one extra frame.
        set(new_wait "${old_wait}\n            if (disp_ctx->disp_type == LVGL_PORT_DISP_TYPE_RGB) {\n                xSemaphoreTake(disp_ctx->trans_sem, portMAX_DELAY);\n            }")
        string(REPLACE "${old_wait}" "${new_wait}" source_code "${source_code}")
        message(STATUS "Applied RGB direct-DMA two-VSYNC wait for IDF 6.0.0")
    endif()

    set(patched_source "${CMAKE_BINARY_DIR}/esp_lvgl_port_compat/esp_lvgl_port_disp.c")
    file(CONFIGURE OUTPUT "${patched_source}" CONTENT "${source_code}" @ONLY)
    get_target_property(port_sources lvgl_port_lib SOURCES)
    set(replaced_sources "")
    set(replaced_count 0)
    foreach(source IN LISTS port_sources)
        if(source STREQUAL relative_source OR source STREQUAL original_source)
            list(APPEND replaced_sources "${patched_source}")
            math(EXPR replaced_count "${replaced_count} + 1")
        else()
            list(APPEND replaced_sources "${source}")
        endif()
    endforeach()
    if(NOT replaced_count EQUAL 1)
        message(FATAL_ERROR "esp_lvgl_port build layout changed; review the compatibility correction.")
    endif()
    set_property(TARGET lvgl_port_lib PROPERTY SOURCES "${replaced_sources}")
    # Resolve the source's relative PPA include against the original directory.
    target_include_directories(lvgl_port_lib PRIVATE "${port_dir}/src/lvgl9")
    message(STATUS "Applied esp_lvgl_port 2.9.0 DPI callback correction for IDF 6.0.0")
endfunction()

apply_esp_lvgl_port_compat()
