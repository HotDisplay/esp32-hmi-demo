menu "Touch Selection"

    config DISPLAY_USE_TOUCHPAD
        bool "Enable Touch Panel"
        default n
        help
            Enable touch independently of the selected display panel.
            Native LCD test mode does not initialize touch.

    choice BSP_TOUCH_CONTROLLER
        prompt "Touch Controller"
        depends on DISPLAY_USE_TOUCHPAD
        default BSP_TOUCH_GT911
        help
            Select the driver for the touch controller connected to the board.
            Changing the display panel does not change this selection.

        config BSP_TOUCH_GT911
            bool "GT911"

        config BSP_TOUCH_AXS15260D
            bool "AXS15260D"
    endchoice

    config BSP_TOUCH_NONE
        bool
        default y if !DISPLAY_USE_TOUCHPAD

endmenu
