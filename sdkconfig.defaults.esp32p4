# enable the experimental features for higher PSRAM speed
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# LCD_CAM support 24 data lines at most
CONFIG_LV_COLOR_DEPTH_24=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# DEMO-A02: C6 Hosted on BSP_SD2 / SDMMC Slot 1; reset is IO expander P00.
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=n
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=20000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=47
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=46
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=48
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=49
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=50
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=51
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
# Unused by the DEMO-A02 reset patch: C6 EN is expander P00, never P4 GPIO0.
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=0
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
CONFIG_ESP_HOSTED_HOST_POWER_SAVE_ENABLED=n
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
CONFIG_ESP_HOSTED_RAW_THROUGHPUT_TRANSPORT=n

